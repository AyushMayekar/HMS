# ============================================================
# Meridian Care Hospital Management System - Environment Config
# ============================================================

# LLM Configuration
LLM_BASE_URL = https://genailab.tcs.in
LLM_API_KEY = your_llm_api_key_here
LLM_MODEL = genailab-maas-gpt-5.4
LLM_MODEL_FALLBACK = genailab-maas-gpt-5.4-mini
EMBEDDING_MODEL = azure/genailab-maas-text-embedding-3-large
EMBEDDING_DIMENSION = 1536

# Supabase Configuration
SUPABASE_URL = https://your-project.supabase.co
SUPABASE_KEY = your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY = your_supabase_service_role_key_here

# SMTP (optional, for real email delivery)
BREVO_SMTP = your_brevo_smtp_key

# RAG Configuration
RAG_SOURCE_DOCUMENTS_TABLE = "knowledge_documents"
RAG_EMBEDDINGS_TABLE = "document_chunks"
RAG_MATCH_FUNCTION = "match_knowledge_documents"
RAG_CHUNK_SIZE = 1000
RAG_CHUNK_OVERLAP = 150
RAG_TOP_K = 4
RAG_MATCH_THRESHOLD = 0.50

# Hospital Configuration
HOSPITAL_TIMEZONE = Asia/Kolkata

# ML Model Configuration
# Leave unset to use the packaged models in app/ml/models (CWD-independent).
# ML_MODEL_PATH =
ML_NO_SHOW_MODEL_VERSION = v1.0
ML_WAITING_TIME_MODEL_VERSION = v1.0

BASE_URL = http://127.0.0.1:8000
API_ACCESS_TOKEN = 
REQUEST_TIMEOUT = 30
PATIENT_ACCESS_TOKEN = 
STAFF_ACCESS_TOKEN = 
ADMIN_ACCESS_TOKEN = 